# ---------------------------------------------------------------
# FT-Twin 后端环境变量示例
# 复制为 .env 后按需修改（settings.py 直接读取系统环境变量，
# 若用 python-dotenv 可在 manage.py 里 load_dotenv，或直接 export）
# ---------------------------------------------------------------

# 安全
DJANGO_SECRET_KEY=dev-only-insecure-key-change-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 跨域（前端开发地址，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 数据库：sqlite（默认，零依赖）| mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
DB_NAME=fttwin
DB_USER=fttwin
DB_PASSWORD=fttwin
DB_HOST=127.0.0.1
DB_PORT=3306

# MQTT（EMQX）：后端发布告警/指令，前端经 WebSocket 订阅状态
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORT=8083
MQTT_USERNAME=
MQTT_PASSWORD=
